generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  moderator
  admin
}

enum UserMediaKind {
  avatar
  banner
}

enum CommentDeletionOrigin {
  author
  video_owner
  moderator
  admin
  account_deletion
  legacy_unknown
}

enum VideoVisibility {
  public
  unlisted
}

enum VideoLicense {
  all_rights_reserved
  cc_by
  cc_by_sa
  cc_by_nd
  cc_by_nc
  cc_by_nc_sa
  cc_by_nc_nd
  cc0
}

enum VideoModerationStatus {
  pending
  approved
  rejected
}

enum VideoProcessingStatus {
  draft
  uploading
  queued
  processing
  ready
  failed
}

enum VideoUploadSessionStatus {
  initializing
  initiated
  uploading
  completing
  completed
  aborting
  aborted
  expiring
  expired
}

enum VideoTranscodeJobStatus {
  queued
  processing
  completed
  failed
}

enum VideoArtifactGenerationState {
  writing
  active
  retiring
  retired
}

enum VideoRenditionQuality {
  p480  @map("480p")
  p720  @map("720p")
  p1080 @map("1080p")
}

enum ExternalResourceSelectorKind {
  exact
  prefix
}

enum ExternalResourceGoal {
  present
  absent
}

enum ExternalResourceState {
  writing
  quiescing
  reconciling
  confirmed_present
  confirmed_absent
}

enum ExternalResourceRole {
  source
  source_thumbnail
  hls_artifacts
  thumbnail_prefix
  user_media
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  username     String    @unique @db.VarChar(20)
  displayName  String?   @map("display_name") @db.VarChar(30)
  passwordHash String    @map("password_hash")
  bio          String?   @db.VarChar(200)
  role         UserRole  @default(user)
  isVerified   Boolean   @default(false) @map("is_verified")
  isBanned     Boolean   @default(false) @map("is_banned")
  bannedAt     DateTime? @map("banned_at")
  banReason    String?   @map("ban_reason") @db.VarChar(1000)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLogin    DateTime? @map("last_login")

  sessions Session[]

  emailVerificationTokens EmailVerificationToken[]
  passwordResetToken      PasswordResetToken?
  mediaAssets             UserMediaAsset[]
  following               UserFollow[]             @relation("UserFollowing")
  followers               UserFollow[]             @relation("UserFollowers")
  videos                  Video[]
  videoRatings            VideoRating[]
  videoViews              VideoView[]
  comments                Comment[]                @relation("CommentAuthor")
  videoUploadSessions     VideoUploadSession[]

  @@map("users")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@index([followerId, createdAt, followingId])
  @@map("user_follows")
}

model UserMediaAsset {
  id                       String        @id @default(uuid()) @db.Uuid
  userId                   String        @map("user_id") @db.Uuid
  kind                     UserMediaKind
  objectKey                String        @unique @map("object_key") @db.VarChar(512)
  bucket                   String        @db.VarChar(128)
  externalResourceTargetId String        @unique @map("external_resource_target_id") @db.Uuid
  mimeType                 String        @map("mime_type") @db.VarChar(100)
  sizeBytes                Int           @map("size_bytes")
  width                    Int
  height                   Int
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalResourceTarget ExternalResourceTarget @relation(fields: [externalResourceTargetId], references: [id])

  @@unique([userId, kind])
  @@map("user_media_assets")
}

model Video {
  id                         String                @id @default(uuid()) @db.Uuid
  publicId                   String                @unique @map("public_id") @db.VarChar(64)
  ownerId                    String                @map("owner_id") @db.Uuid
  title                      String                @db.VarChar(120)
  description                String?               @db.VarChar(5000)
  tags                       String[]              @default([])
  license                    VideoLicense          @default(all_rights_reserved)
  visibility                 VideoVisibility       @default(unlisted)
  allowComments              Boolean               @default(true) @map("allow_comments")
  processingStatus           VideoProcessingStatus @default(draft) @map("processing_status")
  moderationStatus           VideoModerationStatus @default(pending) @map("moderation_status")
  sourceUploadSessionId      String?               @unique @map("source_upload_session_id") @db.Uuid
  sourceObjectKey            String?               @unique @map("source_object_key") @db.VarChar(512)
  sourceSizeBytes            BigInt?               @map("source_size_bytes")
  activeArtifactGenerationId String?               @unique @map("active_artifact_generation_id") @db.Uuid
  hlsMasterObjectKey         String?               @unique @map("hls_master_object_key") @db.VarChar(512)
  thumbnailObjectKey         String?               @unique @map("thumbnail_object_key") @db.VarChar(512)
  durationSeconds            Int?                  @map("duration_seconds")
  width                      Int?
  height                     Int?
  viewCount                  Int                   @default(0) @map("view_count")
  ratingSum                  Int                   @default(0) @map("rating_sum")
  ratingCount                Int                   @default(0) @map("rating_count")
  commentCount               Int                   @default(0) @map("comment_count")
  transcodeError             String?               @map("transcode_error") @db.VarChar(1000)
  publishedAt                DateTime?             @map("published_at")
  rejectedAt                 DateTime?             @map("rejected_at")
  rejectionReason            String?               @map("rejection_reason") @db.VarChar(1000)
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  owner                    User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sourceUploadSession      VideoUploadSession?       @relation("CurrentVideoSource", fields: [sourceUploadSessionId], references: [id], onDelete: SetNull)
  activeArtifactGeneration VideoArtifactGeneration?  @relation("ActiveArtifactGeneration", fields: [activeArtifactGenerationId], references: [id], onDelete: SetNull)
  artifactGenerations      VideoArtifactGeneration[] @relation("VideoArtifactGenerations")
  ratings                  VideoRating[]
  views                    VideoView[]
  comments                 Comment[]
  transcodeJobs            VideoTranscodeJob[]
  uploadSessions           VideoUploadSession[]      @relation("VideoUploadSessions")

  @@index([ownerId, createdAt, id])
  @@index([visibility, moderationStatus, processingStatus, createdAt, id])
  @@index([moderationStatus, rejectedAt, id])
  @@map("videos")
}

model VideoRating {
  userId    String   @map("user_id") @db.Uuid
  videoId   String   @map("video_id") @db.Uuid
  value     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
  @@index([userId, createdAt, videoId])
  @@map("video_ratings")
}

model VideoView {
  userId   String   @map("user_id") @db.Uuid
  videoId  String   @map("video_id") @db.Uuid
  viewedOn DateTime @map("viewed_on") @db.Date

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId, viewedOn])
  @@index([videoId])
  @@index([userId, viewedOn, videoId])
  @@map("video_views")
}

model Comment {
  id                  String                 @id @default(uuid()) @db.Uuid
  authorId            String?                @map("author_id") @db.Uuid
  videoId             String                 @map("video_id") @db.Uuid
  rootId              String?                @map("root_id") @db.Uuid
  replyingToCommentId String?                @map("replying_to_comment_id") @db.Uuid
  content             String?                @db.VarChar(800)
  createdAt           DateTime               @default(now()) @map("created_at")
  deletedAt           DateTime?              @map("deleted_at")
  deletionOrigin      CommentDeletionOrigin? @map("deletion_origin")

  author            User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  video             Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  root              Comment?  @relation("CommentThread", fields: [rootId], references: [id], onDelete: Cascade)
  replies           Comment[] @relation("CommentThread")
  replyingToComment Comment?  @relation("CommentReplyTarget", fields: [replyingToCommentId], references: [id], onDelete: SetNull)
  addressedReplies  Comment[] @relation("CommentReplyTarget")

  @@index([videoId, rootId, createdAt, id])
  @@index([rootId, createdAt, id])
  @@index([authorId])
  @@index([authorId, createdAt, id])
  @@index([replyingToCommentId])
  @@map("comments")
}

model VideoRendition {
  id                   String                @id @default(uuid()) @db.Uuid
  artifactGenerationId String                @map("artifact_generation_id") @db.Uuid
  quality              VideoRenditionQuality
  width                Int
  height               Int
  bitrate              Int
  playlistObjectKey    String                @unique @map("playlist_object_key") @db.VarChar(512)
  segmentPrefix        String                @map("segment_prefix") @db.VarChar(512)
  codec                String                @db.VarChar(50)
  container            String                @db.VarChar(50)
  createdAt            DateTime              @default(now()) @map("created_at")

  artifactGeneration VideoArtifactGeneration @relation(fields: [artifactGenerationId], references: [id], onDelete: Cascade)

  @@unique([artifactGenerationId, quality])
  @@map("video_renditions")
}

model VideoTranscodeJob {
  id              String                  @id @default(uuid()) @db.Uuid
  videoId         String                  @map("video_id") @db.Uuid
  status          VideoTranscodeJobStatus @default(queued)
  sourceObjectKey String                  @map("source_object_key") @db.VarChar(512)
  attempts        Int                     @default(0)
  maxAttempts     Int                     @default(5) @map("max_attempts")
  lastError       String?                 @map("last_error") @db.VarChar(1000)
  nextAttemptAt   DateTime                @default(now()) @map("next_attempt_at")
  executionId     String?                 @unique @map("execution_id") @db.Uuid
  heartbeatAt     DateTime?               @map("heartbeat_at")
  startedAt       DateTime?               @map("started_at")
  completedAt     DateTime?               @map("completed_at")
  failedAt        DateTime?               @map("failed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  video                    Video                     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoArtifactGenerations VideoArtifactGeneration[]

  @@unique([videoId, sourceObjectKey])
  @@index([status, nextAttemptAt, id])
  @@index([videoId, status])
  @@index([heartbeatAt])
  @@map("video_transcode_jobs")
}

model VideoArtifactGeneration {
  id                    String                       @id @default(uuid()) @db.Uuid
  videoId               String                       @map("video_id") @db.Uuid
  sourceUploadSessionId String                       @map("source_upload_session_id") @db.Uuid
  transcodeJobId        String                       @map("transcode_job_id") @db.Uuid
  executionId           String                       @unique @map("execution_id") @db.Uuid
  bucket                String                       @db.VarChar(128)
  state                 VideoArtifactGenerationState @default(writing)
  hlsMasterObjectKey    String?                      @unique @map("hls_master_object_key") @db.VarChar(512)
  thumbnailObjectKey    String?                      @unique @map("thumbnail_object_key") @db.VarChar(512)
  activatedAt           DateTime?                    @map("activated_at")
  retiredAt             DateTime?                    @map("retired_at")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")

  video               Video              @relation("VideoArtifactGenerations", fields: [videoId], references: [id], onDelete: Cascade)
  sourceUploadSession VideoUploadSession @relation(fields: [sourceUploadSessionId], references: [id], onDelete: Cascade)
  transcodeJob        VideoTranscodeJob  @relation(fields: [transcodeJobId], references: [id], onDelete: Cascade)
  activeForVideo      Video?             @relation("ActiveArtifactGeneration")
  renditions          VideoRendition[]

  @@index([videoId, state])
  @@index([state, updatedAt, id])
  @@index([sourceUploadSessionId])
  @@index([transcodeJobId])
  @@map("video_artifact_generations")
}

model ExternalResourceTarget {
  id                           String                       @id @default(uuid()) @db.Uuid
  userId                       String                       @map("user_id") @db.Uuid
  videoId                      String?                      @map("video_id") @db.Uuid
  bucket                       String                       @db.VarChar(128)
  selector                     String                       @db.VarChar(512)
  selectorKind                 ExternalResourceSelectorKind @map("selector_kind")
  role                         ExternalResourceRole
  generation                   String                       @db.VarChar(128)
  expectedSizeBytes            BigInt?                      @map("expected_size_bytes")
  mayHaveMultipartUpload       Boolean                      @default(false) @map("may_have_multipart_upload")
  goal                         ExternalResourceGoal         @default(present)
  state                        ExternalResourceState        @default(writing)
  quiescenceNotBefore          DateTime?                    @map("quiescence_not_before")
  attempts                     Int                          @default(0)
  lastError                    String?                      @map("last_error") @db.VarChar(1000)
  nextAttemptAt                DateTime                     @default(now()) @map("next_attempt_at")
  reconciliationLeaseId        String?                      @map("reconciliation_lease_id") @db.Uuid
  reconciliationLeaseExpiresAt DateTime?                    @map("reconciliation_lease_expires_at")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")

  uploadSessions   VideoUploadSession[]
  multipartHandles ExternalMultipartHandle[]
  sourceThumbnails VideoSourceThumbnail[]
  userMediaAssets  UserMediaAsset[]

  @@unique([bucket, selectorKind, selector])
  @@index([role, state, nextAttemptAt, id])
  @@index([reconciliationLeaseExpiresAt])
  @@index([userId, role, state])
  @@index([videoId, role, state])
  @@map("external_resource_targets")
}

model ExternalMultipartHandle {
  id              String   @id @default(uuid()) @db.Uuid
  targetId        String   @map("target_id") @db.Uuid
  uploadSessionId String?  @unique @map("upload_session_id") @db.Uuid
  uploadId        String   @map("upload_id") @db.VarChar(1024)
  createdAt       DateTime @default(now()) @map("created_at")

  target        ExternalResourceTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  uploadSession VideoUploadSession?    @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)

  @@unique([targetId, uploadId])
  @@map("external_multipart_handles")
}

model VideoUploadSession {
  id                       String                   @id @default(uuid()) @db.Uuid
  videoId                  String                   @map("video_id") @db.Uuid
  userId                   String                   @map("user_id") @db.Uuid
  status                   VideoUploadSessionStatus @default(initializing)
  bucket                   String                   @db.VarChar(128)
  objectKey                String                   @map("object_key") @db.VarChar(512)
  partSizeBytes            Int                      @map("part_size_bytes")
  expectedSizeBytes        BigInt                   @map("expected_size_bytes")
  partCount                Int?                     @map("part_count")
  expiresAt                DateTime                 @map("expires_at")
  completedAt              DateTime?                @map("completed_at")
  abortedAt                DateTime?                @map("aborted_at")
  expiredAt                DateTime?                @map("expired_at")
  externalResourceTargetId String                   @unique @map("external_resource_target_id") @db.Uuid
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  video                  Video                     @relation("VideoUploadSessions", fields: [videoId], references: [id], onDelete: Cascade)
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentForVideo        Video?                    @relation("CurrentVideoSource")
  externalResourceTarget ExternalResourceTarget    @relation(fields: [externalResourceTargetId], references: [id])
  multipartHandle        ExternalMultipartHandle?
  sourceThumbnail        VideoSourceThumbnail?
  artifactGenerations    VideoArtifactGeneration[]
  parts                  VideoUploadPart[]

  @@unique([bucket, objectKey])
  @@index([videoId, status])
  @@index([userId, createdAt, id])
  @@index([expiresAt])
  @@map("video_upload_sessions")
}

model VideoSourceThumbnail {
  id                       String   @id @default(uuid()) @db.Uuid
  uploadSessionId          String   @unique @map("upload_session_id") @db.Uuid
  externalResourceTargetId String   @unique @map("external_resource_target_id") @db.Uuid
  bucket                   String   @db.VarChar(128)
  objectKey                String   @unique @map("object_key") @db.VarChar(512)
  mimeType                 String   @map("mime_type") @db.VarChar(100)
  sizeBytes                Int      @map("size_bytes")
  width                    Int
  height                   Int
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  uploadSession          VideoUploadSession     @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  externalResourceTarget ExternalResourceTarget @relation(fields: [externalResourceTargetId], references: [id])

  @@map("video_source_thumbnails")
}

model VideoUploadPart {
  id              String   @id @default(uuid()) @db.Uuid
  uploadSessionId String   @map("upload_session_id") @db.Uuid
  partNumber      Int      @map("part_number")
  etag            String   @db.VarChar(255)
  sizeBytes       Int?     @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at")

  uploadSession VideoUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, partNumber])
  @@map("video_upload_parts")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_token")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  sessionKey       String   @unique @map("session_key")
  sessionKeySuffix String?  @map("session_key_suffix")
  userId           String   @map("user_id") @db.Uuid
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.VarChar(512)
  deviceInfo       String?  @map("device_info") @db.VarChar(512)
  isActive         Boolean  @default(true) @map("is_active")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  lastUsedAt       DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionKeySuffix])
  @@index([expiresAt])
  @@index([userId, isActive, expiresAt])
  @@index([userId, isActive, lastUsedAt, id])
  @@index([userId, createdAt, id])
  @@index([isActive, updatedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_token")
}
