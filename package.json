{
  "name": "fp-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "FairPlay backend API built with TypeScript, Express, Prisma, and Bun.",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun --watch scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:integration": "vitest run --config vitest.config.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bun run prisma:migrate:dev",
    "prisma:migrate:dev": "bunx prisma migrate dev",
    "prisma:migrate:deploy": "bunx prisma migrate deploy",
    "prisma:migrate:status": "bunx prisma migrate status",
    "prisma:studio": "bunx prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "nodemailer": "^8.0.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^5.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "qs": "6.15.2",
    "fast-uri": "3.1.2",
    "brace-expansion": "5.0.6",
    "hono": "4.12.22",
    "@hono/node-server": "2.0.3"
  }
}
