PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://user:password@localhost:5432/fairplay
BASE_URL=http://localhost:3000
BCRYPT_ROUNDS=12
JSON_BODY_LIMIT_BYTES=1048576
SESSION_CLEANUP_INTERVAL_MINUTES=60
SESSION_CLEANUP_INACTIVE_RETENTION_DAYS=30
TRUST_PROXY=false
CORS_ORIGINS=*
REDIS_URL=redis://localhost:6379
RATE_LIMIT_KEY_SECRET=change-me-with-at-least-32-characters
# Local development default targets the MinIO service exposed by Docker Compose. Production should
# set the same OBJECT_STORAGE_* variables to the shared S3-compatible service.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=fairplay-user-media
OBJECT_STORAGE_ACCESS_KEY=fairplay
OBJECT_STORAGE_SECRET_KEY=fairplay-minio-secret
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
# Shared raw upload limit for profile media, currently avatar and banner.
PROFILE_MEDIA_MAX_UPLOAD_BYTES=3145728
# Optional Docker Compose interpolation overrides for local container-network experiments.
# Production does not use COMPOSE_OBJECT_STORAGE_*.
# COMPOSE_OBJECT_STORAGE_ENDPOINT=http://minio:9000
# COMPOSE_OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=change-me
# SMTP_FROM=no-reply@example.com
# FRONTEND_URL=http://localhost:5173
