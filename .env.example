PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://user:password@localhost:5432/fairplay
BASE_URL=http://localhost:3000
BCRYPT_ROUNDS=12
JSON_BODY_LIMIT_BYTES=1048576
SESSION_CLEANUP_INTERVAL_MINUTES=60
SESSION_CLEANUP_INACTIVE_RETENTION_DAYS=30
TRUST_PROXY=false
CORS_ORIGINS=*
REDIS_URL=redis://localhost:6379
RATE_LIMIT_KEY_SECRET=change-me-with-at-least-32-characters
AUTH_CODE_PEPPER=change-me-auth-code-pepper-32-characters
# Local development default targets the MinIO service exposed by Docker Compose. Production should
# set the same OBJECT_STORAGE_* variables to the shared S3-compatible service.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=fairplay-user-media
OBJECT_STORAGE_ACCESS_KEY=fairplay
OBJECT_STORAGE_SECRET_KEY=fairplay-minio-secret
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_TIMEOUT_MS=5000
# Shared raw upload limit for profile media, currently avatar and banner.
PROFILE_MEDIA_MAX_UPLOAD_BYTES=3145728
# Multipart video uploads reserve the declared size before S3 is contacted. Completed and replaced
# sources continue to count toward quota until their S3 absence is confirmed.
VIDEO_OBJECT_STORAGE_BUCKET=videos
VIDEO_UPLOAD_PART_SIZE_BYTES=67108864
VIDEO_UPLOAD_MAX_PARTS=10000
VIDEO_UPLOAD_MAX_BYTES=3221225472
VIDEO_USER_STORAGE_QUOTA_BYTES=107374182400
VIDEO_UPLOAD_SESSION_TTL_SECONDS=86400
# Per-process transcode capacity. Set concurrent jobs to 0 on replicas that must not transcode.
VIDEO_TRANSCODE_MAX_CONCURRENT_JOBS=1
VIDEO_TRANSCODE_THREADS_PER_JOB=2
# Optional Docker Compose interpolation overrides for local container-network experiments.
# Production does not use COMPOSE_OBJECT_STORAGE_*.
# COMPOSE_OBJECT_STORAGE_ENDPOINT=http://minio:9000
# COMPOSE_OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP_USER=user@example.com
# SMTP_PASS=change-me
# SMTP_FROM=no-reply@example.com
# SMTP_TIMEOUT_MS=10000
